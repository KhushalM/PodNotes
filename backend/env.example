# OpenSearch Configuration
OPENSEARCH_DOMAIN_ENDPOINT=https://your-domain-endpoint.us-east-1.es.amazonaws.com
OPENSEARCH_AUTH_METHOD=master_user
OPENSEARCH_MASTER_USERNAME=your-username
OPENSEARCH_MASTER_PASSWORD=your-password

# AWS Configuration (if using IAM authentication)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1

# Application Settings
IS_LOCAL=false
MOCK_MODE=false

# HuggingFace Token (required for pyannote.audio diarization)
# Get your token from https://huggingface.co/settings/tokens
# You need to accept the user agreement at:
# - https://huggingface.co/pyannote/speaker-diarization
# - https://huggingface.co/pyannote/segmentation
HUGGINGFACE_TOKEN=your-huggingface-token
